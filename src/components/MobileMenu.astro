---
import { Menu, X } from '@lucide/astro';
---
<button class="mobile-menu-trigger" type="button" aria-label="메뉴 열기" data-i18n-aria="common.menu.open" aria-controls="mobile-menu" aria-expanded="false" data-mobile-menu-open>
  <Menu size={22} aria-hidden="true" />
</button>
<dialog id="mobile-menu" aria-labelledby="mobile-menu-title">
  <div class="mobile-menu-heading">
    <button type="button" class="mobile-menu-close" aria-label="메뉴 닫기" data-i18n-aria="common.menu.close" data-mobile-menu-close autofocus><X size={24} aria-hidden="true" /></button>
    <strong id="mobile-menu-title" data-i18n="common.menu.title">메뉴</strong>
  </div>
  <div class="mobile-menu-body">
    <nav class="mobile-primary" aria-label="주요 탐색" data-i18n-aria="common.nav.aria">
      <a href="/" data-astro-reload data-i18n="common.nav.home">Home</a>
      <a href="/docs/" data-astro-reload data-i18n="common.nav.docs">Docs</a>
      <a href="/api/" data-astro-reload data-i18n="common.nav.api">API</a>
    </nav>
    <div data-mobile-menu-controls></div>
    <div data-mobile-menu-navigation></div>
  </div>
</dialog>

<script>
  const mobile = window.matchMedia('(max-width: 900px)');
  let moved: Array<{ element: HTMLElement; placeholder: Comment }> = [];
  let activeDialog: HTMLDialogElement | null = null;
  let previousOverflow = '';

  function restoreMenu() {
    for (const { element, placeholder } of moved) placeholder.replaceWith(element);
    moved = [];
    document.documentElement.style.overflow = previousOverflow;
    document.querySelector('[data-mobile-menu-open]')?.setAttribute('aria-expanded', 'false');
    activeDialog = null;
  }

  function closeMenu() {
    if (!activeDialog) return;
    activeDialog.close();
    restoreMenu();
  }

  function openMenu() {
    const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');
    if (!mobile.matches || !dialog || dialog.open) return;
    for (const [selector, destination] of [
      ['.documentation-selectors', '[data-mobile-menu-controls]'],
      ['.kc-sidebar', '[data-mobile-menu-navigation]'],
    ]) {
      const element = document.querySelector<HTMLElement>(selector);
      const container = dialog.querySelector(destination);
      if (!element || !container) continue;
      const placeholder = document.createComment('mobile-menu-origin');
      element.before(placeholder);
      container.append(element);
      moved.push({ element, placeholder });
    }
    previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    activeDialog = dialog;
    dialog.showModal();
    document.querySelector('[data-mobile-menu-open]')?.setAttribute('aria-expanded', 'true');
    dialog.addEventListener('close', () => {
      if (activeDialog === dialog && !dialog.open) restoreMenu();
    }, { once: true });
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-mobile-menu-open]')) openMenu();
    else if (event.target.closest('[data-mobile-menu-close], #mobile-menu a[href]')) closeMenu();
  });
  // Restore persisted navigation before Astro moves it into the next document.
  document.addEventListener('astro:before-swap', closeMenu);
  window.addEventListener('pagehide', closeMenu);
  mobile.addEventListener('change', () => { if (!mobile.matches) closeMenu(); });
</script>

<style>
  .mobile-menu-trigger, .mobile-menu-close {
    align-items: center; background: transparent; border: 1px solid var(--kc-border);
    border-radius: .75rem; color: var(--kc-text); cursor: pointer;
    display: inline-flex; flex: 0 0 auto; justify-content: center; width: 44px; height: 44px;
  }
  .mobile-menu-trigger { display: none; }
  dialog {
    background: var(--kc-surface); border: 0; color: var(--kc-text);
    height: 100dvh; inset: 0; margin: 0; max-height: none; max-width: none;
    padding: 0; width: 100%;
  }
  dialog[open] { display: flex; flex-direction: column; }
  dialog::backdrop { background: var(--kc-surface); }
  .mobile-menu-heading {
    align-items: center; border-bottom: 1px solid var(--kc-border); display: flex;
    flex: 0 0 auto; gap: 1rem; padding: max(.75rem, env(safe-area-inset-top)) 1rem .75rem;
  }
  .mobile-menu-body {
    flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
    padding: 1.25rem max(1rem, env(safe-area-inset-right)) max(2rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
  }
  .mobile-primary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; margin-bottom: 1.5rem; }
  .mobile-primary a { border: 1px solid var(--kc-border); border-radius: .75rem; color: var(--kc-text); padding: .85rem .5rem; text-align: center; text-decoration: none; }
  [data-mobile-menu-controls]:not(:empty) { border-bottom: 1px solid var(--kc-border); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
  dialog :global(.documentation-selectors) { display: flex; flex-wrap: wrap; gap: .75rem; }
  dialog :global(.documentation-selectors .kc-select__trigger) { max-width: none; }
  dialog :global(.documentation-selectors .kc-select__menu) { left: 0; right: auto; min-width: 10rem; max-width: calc(100vw - 2rem); }
  dialog :global(.kc-sidebar) { display: block; position: static; border: 0; padding: 0; max-height: none; overflow: visible; }
  @media (max-width: 900px) { .mobile-menu-trigger { display: inline-flex; } }
</style>
