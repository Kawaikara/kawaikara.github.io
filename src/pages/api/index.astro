---
import DocsPageLayout from '../../layouts/DocsPageLayout.astro';
import {
  defaultDocumentationVersion,
  getReferenceRoot,
  hasSection,
} from '../../data/documentation';

const version = defaultDocumentationVersion;
const appApiHref = version && hasSection(version, 'app-api')
  ? getReferenceRoot(version, 'app-api')
  : undefined;
const builtinSitesHref = version && hasSection(version, 'builtin-sites')
  ? getReferenceRoot(version, 'builtin-sites')
  : undefined;
const siteApiHref = version && hasSection(version, 'site-api')
  ? getReferenceRoot(version, 'site-api')
  : undefined;
---

<DocsPageLayout
  title="Kawaikara API"
  description="Kawaikara Source API, Built-in Sites와 Site API 레퍼런스입니다."
  documentationVersion={version}
  documentationSection="app-api"
>
  <h1>Kawaikara API</h1>
  <p class="doc-lead">앱 내부 구현, 빌트인 Provider와 Site API를 버전별로 확인할 수 있습니다.</p>

  <div class="doc-grid">
    {appApiHref
      ? <a class="doc-card" href={appApiHref}><strong>Source API</strong><span>Kawaikara 앱의 모듈, 클래스, 인터페이스, 함수, 타입 및 내부 값</span></a>
      : <div class="doc-card"><strong>Source API</strong><span>선택한 버전에 생성된 API가 없습니다.</span></div>}
    {builtinSitesHref
      ? <a class="doc-card" href={builtinSitesHref}><strong>Built-in Sites</strong><span>함께 배포되는 Site Provider, 페이지 주입 코드와 번들 진입점</span></a>
      : <div class="doc-card doc-card--disabled"><strong>Built-in Sites</strong><span>선택한 버전에는 별도 Built-in Sites 레퍼런스가 없습니다.</span></div>}
    {siteApiHref
      ? <a class="doc-card" href={siteApiHref}><strong>Site API</strong><span>Provider와 Plugin 개발에 사용하는 Site API 전체 레퍼런스</span></a>
      : <div class="doc-card"><strong>Site API</strong><span>선택한 버전에는 별도 Site API가 없습니다.</span></div>}
  </div>
</DocsPageLayout>
